# Copiar para .env (fora do git) antes do `pnpm generate` de produção.
NUXT_PUBLIC_SITE_URL=https://agenva.app.br

# Firebase — app WEB do projeto do AGENVA (console → Configurações do projeto → Seus apps → Web)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# API e admins do painel /admin
NUXT_PUBLIC_API_BASE_URL=https://api-agenva.kidev.tec.br
NUXT_PUBLIC_ADMIN_EMAILS=
